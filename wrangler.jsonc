{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satchel",
  "main": "src/workerEntry.ts",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["WEBHOOK_SECRET", "ACCOUNT_ID_SECRET"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "Account"
      }
    ]
  },
  "exports": {
    "Account": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
