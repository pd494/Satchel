{
  "name": "satchel",
  "account_id": "75646cd038d25b1b0e4b4545e4c09ef1",
  "main": "build/index.js",
  "compatibility_date": "2026-09-14",
  "routes": [{ "pattern": "api.textsatchel.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "USER", "class_name": "User" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["User"] }],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "SENDER_LIMIT", "namespace_id": "867530201", "simple": { "limit": 10, "period": 60 } },
    { "name": "TOTAL_LIMIT", "namespace_id": "867530202", "simple": { "limit": 100, "period": 60 } }
  ],
  "build": {
    "command": "cargo install -q \"worker-build@^0.8\" && worker-build --release"
  }
}
